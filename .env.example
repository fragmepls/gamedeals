# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/gamedeals
POSTGRES_USER=
POSTGRES_PASSWORD=
ITAD_API_KEY=
# Two-letter country code; decides store availability and currency.
# Keep it fixed: changing it mixes currencies in the price history.
ITAD_COUNTRY=AT
# Optional: without it the poller just logs alerts
DISCORD_WEBHOOK_URL=
PORT=3000
